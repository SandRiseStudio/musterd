{
  "name": "@musterd/mcp",
  "version": "0.4.1",
  "description": "musterd universal harness adapter: one MCP server that joins any MCP-capable agent to a team",
  "license": "MIT",
  "homepage": "https://musterd.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandRiseStudio/musterd.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/SandRiseStudio/musterd/issues",
  "keywords": [
    "agents",
    "multi-agent",
    "coordination",
    "mcp",
    "team",
    "mcp-server",
    "adapter",
    "claude-code",
    "codex",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musterd-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
