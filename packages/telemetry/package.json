{
  "name": "@musterd/telemetry",
  "version": "0.4.1",
  "description": "musterd telemetry SDK: the shared OTLP bootstrap every component boots (server, MCP adapter, CLI)",
  "license": "MIT",
  "homepage": "https://musterd.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandRiseStudio/musterd.git",
    "directory": "packages/telemetry"
  },
  "bugs": "https://github.com/SandRiseStudio/musterd/issues",
  "keywords": [
    "agents",
    "multi-agent",
    "coordination",
    "mcp",
    "team",
    "telemetry",
    "opentelemetry",
    "otlp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/stamp-build.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  }
}
