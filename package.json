{
  "name": "musterd-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json}\" && pnpm roadmap:check && pnpm roadmap-truth:check && pnpm arch-trees:check && pnpm obs-evals:check && pnpm adr-numbers:check && pnpm guidance:check && pnpm vocab:check && pnpm tokens:check && pnpm migrations:check && pnpm source-nul:check && pnpm wiki:check",
    "adr:next": "node --disable-warning=ExperimentalWarning scripts/adr-next.ts",
    "adr-numbers:check": "node --disable-warning=ExperimentalWarning scripts/check-adr-numbers.ts",
    "migrations:check": "node --disable-warning=ExperimentalWarning scripts/check-migrations.ts",
    "source-nul:check": "node --disable-warning=ExperimentalWarning scripts/check-source-nul.ts",
    "dist:check": "node --disable-warning=ExperimentalWarning scripts/check-dist-freshness.ts",
    "vocab:check": "node --disable-warning=ExperimentalWarning scripts/check-vocab.ts",
    "tokens:check": "node --disable-warning=ExperimentalWarning scripts/check-css-tokens.ts",
    "wiki:index": "node --disable-warning=ExperimentalWarning scripts/wiki-index.ts",
    "wiki:check": "node --disable-warning=ExperimentalWarning scripts/check-wiki.ts",
    "wiki:probe": "node --disable-warning=ExperimentalWarning scripts/wiki-probe.ts",
    "perf:check": "node --disable-warning=ExperimentalWarning scripts/perf/check-budgets.ts",
    "a11y:contrast": "node scripts/a11y/contrast-sweep.mjs",
    "a11y:check": "node scripts/a11y/contrast-gate.mjs",
    "context:check": "node --disable-warning=ExperimentalWarning scripts/context/check-budgets.ts",
    "guidance:check": "node --disable-warning=ExperimentalWarning scripts/check-guidance.ts",
    "roadmap:gen": "node --disable-warning=ExperimentalWarning scripts/gen-roadmap.ts",
    "roadmap:check": "node --disable-warning=ExperimentalWarning scripts/gen-roadmap.ts --check",
    "roadmap-truth:check": "node --disable-warning=ExperimentalWarning scripts/check-roadmap-truth.ts",
    "steward:scan": "node --disable-warning=ExperimentalWarning scripts/steward/scan.ts",
    "steward:notify": "node --disable-warning=ExperimentalWarning scripts/steward/notify.ts",
    "radar:sweep": "node --disable-warning=ExperimentalWarning scripts/radar/sweep.ts",
    "liveness:sweep": "node --disable-warning=ExperimentalWarning scripts/research/adr-166-slot-sweep.ts",
    "corpus:snapshot": "node --disable-warning=ExperimentalWarning scripts/corpus/snapshot.ts",
    "release": "node --disable-warning=ExperimentalWarning scripts/release.ts",
    "bump-brew-formula": "node --disable-warning=ExperimentalWarning scripts/bump-brew-formula.ts",
    "arch-trees:check": "node --disable-warning=ExperimentalWarning scripts/check-arch-trees.ts --check",
    "obs-evals:check": "node --disable-warning=ExperimentalWarning scripts/check-obs-evals.ts --check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:scenarios": "vitest run tests/scenarios",
    "test:codex-cli-real": "vitest run tests/codex-cli.acceptance.test.ts",
    "typecheck": "pnpm dist:check && pnpm -r exec tsc --noEmit && pnpm exec tsc -p content/tsconfig.json && pnpm exec tsc -p scripts/tsconfig.json",
    "change-adr:check": "node --disable-warning=ExperimentalWarning scripts/check-change-adr.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@musterd/mcp": "workspace:*",
    "@musterd/protocol": "workspace:*",
    "@musterd/server": "workspace:*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "ulid": "^2.3.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "vite@<6.4.3": "^6.4.3"
    }
  }
}
